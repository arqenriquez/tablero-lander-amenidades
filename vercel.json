{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.pdf",
      "headers": [{ "key": "Content-Type", "value": "application/pdf" }]
    }
  ]
}
